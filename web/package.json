{
  "name": "lookahead-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare-assets && next dev",
    "build": "npm run prepare-assets && next build",
    "build:e2e": "npm run prepare-assets && cross-env-shell NEXT_PUBLIC_LOOKAHEAD_API=http://127.0.0.1:4173/mock-api next build",
    "typecheck": "tsc --noEmit",
    "serve": "node scripts/serve.mjs",
    "test:e2e": "playwright test",
    "palette": "node ../scripts/validate_palette.js --config src/theme/palette.json"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "apache-arrow": "17.0.0",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "fzstd": "0.1.1",
    "hyparquet": "1.31.2",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "cross-env": "7.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}

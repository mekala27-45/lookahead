# Copy to .env for a local run. Nothing here is needed for the pipeline or the site.

# The forecast log API. A Neon connection string in production; local Postgres in development.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lookahead
# Writes to /v1/forecasts and /v1/score carry this token in the Authorization header.
LOOKAHEAD_WRITE_TOKEN=change-me
# Where the site reads the live API from at build time.
NEXT_PUBLIC_LOOKAHEAD_API=https://lookahead-grid-api.fly.dev

# Tests: a reachable Postgres for the forecast log tests. Unset, the tests skip with a named reason.
LOOKAHEAD_TEST_DATABASE_URL=

# Deploy: only the machine that runs `make deploy` needs these.
FLY_API_TOKEN=
FLY_APP_NAME=lookahead-grid-api

# Optional: the refresh job (stretch step 19) pulls the latest EIA data with this key.
EIA_API_KEY=
